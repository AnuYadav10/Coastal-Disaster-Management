# Gujarat SmartGuide AI — Environment Configuration
# Copy this file to .env and fill in values as needed.
# The application works fully WITHOUT any API keys (uses demo data).

# ─────────────────────────────────────────────
# OPTIONAL: Real Weather API (currently not required)
# ─────────────────────────────────────────────
# Uncomment and fill in after signing up at openweathermap.org or weatherapi.com
# WEATHER_API_KEY=your_api_key_here
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5/weather

# ─────────────────────────────────────────────
# OPTIONAL: OpenAI (for advanced LLM chat)
# ─────────────────────────────────────────────
# Uncomment to enable GPT-powered responses via LangChain
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-3.5-turbo
